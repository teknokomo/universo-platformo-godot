# Universo Platformo Godot - Environment Configuration
# Copy this file to .env and fill in your actual values

# Backend Server Configuration (frontend communicates with this local server)
BACKEND_PORT=8080

# Supabase Configuration — used by the backend server (auth proxy) and DatabaseManager
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Multiplayer Server Configuration
SERVER_PORT=7777
SERVER_HOST=127.0.0.1

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=info
